{
  "name": "vn-vertical-engine-tests",
  "private": true,
  "scripts": {
    "lint": "cd .. && eslint --config dev/eslint.config.mjs \"engine/*.js\" \"*-example.js\" \"dev/scripts/**/*.mjs\" \"dev/tests/**/*.mjs\" \"dev/*.mjs\"",
    "test:typecheck": "tsc -p tsconfig.checkjs.json",
    "test": "node --test",
    "test:parser": "node --test tests/parser.test.mjs tests/meta.test.mjs tests/diagnostics.test.mjs tests/transitions.test.mjs tests/branching.test.mjs tests/variables.test.mjs tests/assets.test.mjs tests/media-options.test.mjs tests/scene-actions.test.mjs tests/story360-commands.test.mjs tests/loader-stats.test.mjs",
    "test:meta": "node --test tests/meta.test.mjs tests/diagnostics.test.mjs",
    "test:scenes": "node --test tests/scene-actions.test.mjs tests/transitions.test.mjs tests/branching.test.mjs",
    "test:branching": "node --test tests/branching.test.mjs",
    "test:variables": "node --test tests/variables.test.mjs tests/expression-runtime.test.mjs",
    "test:assets": "node --test tests/assets.test.mjs tests/media-options.test.mjs",
    "test:contracts": "node --test tests/resource-path-contract.test.mjs",
    "test:media": "node --test tests/media-options.test.mjs tests/audio-controller.test.mjs tests/story-video-controller.test.mjs tests/background-media-controller.test.mjs tests/character-controller.test.mjs tests/visual-transition-controller.test.mjs",
    "test:360": "node --test tests/story360-commands.test.mjs tests/panorama-css-security.test.mjs tests/panorama-package-controller.test.mjs tests/panorama-photo-viewer-controller.test.mjs tests/panorama-marks-controller.test.mjs",
    "test:stats": "node --test tests/loader-stats.test.mjs tests/story-analysis.test.mjs tests/story-graph.test.mjs",
    "test:autosave": "node --test tests/autosave-storage.test.mjs tests/autosave-payload.test.mjs tests/autosave-controller.test.mjs",
    "test:ui": "node --test tests/ui-config-runtime.test.mjs",
    "test:logs": "node --test tests/runtime-logging.test.mjs",
    "test:defensive": "node --test tests/runtime-defensive-contracts.test.mjs tests/audio-controller.test.mjs tests/background-media-controller.test.mjs tests/panorama-package-controller.test.mjs tests/story-sandbox-loader.test.mjs",
    "test:dependencies": "node --test tests/dependencies.test.mjs",
    "test:license": "node --test tests/license-runtime.test.mjs",
    "test:protocol": "node --test tests/game-protocol.test.mjs tests/game-host.test.mjs",
    "test:release": "node --test tests/bootstrap-runtime.test.mjs tests/release-package.test.mjs tests/release-assets.test.mjs tests/release-checksums.test.mjs tests/release-manifest.test.mjs tests/student-project-auditor.test.mjs",
    "test:release:smoke": "node tests/release-smoke.mjs",
    "test:links": "node --test tests/markdown-links.test.mjs",
    "test:community": "node --test tests/discussion-forms.test.mjs",
    "browser:install": "playwright install chromium firefox",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
